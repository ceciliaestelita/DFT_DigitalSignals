clear all
close all ;
clc

global N f1 a periodos fs tt fs ts
N = 256;
f1 = 10;
a = 1;
periodos = 16;
tt = periodos/f1;
fs = N/tt;
ts = 1/fs;

%% 1.1 Generation of deterministic signals
t = (0:N-1) * ts;
s1=sin(2*pi*f1*t);
n_periods2 = 15.5;
f2 = n_periods2 / tt; 
s2 = a * sin(2*pi*f2*t);

figure(1);
subplot(2,1,1);
plot(t, s1, 'b');
grid on;
xlabel('time (s)');
ylabel('amplitude(V)');
title('s1 (16 periods, 256 samples)');

subplot(2,1,2);
plot(t, s2, 'r');
grid on;
xlabel('time (s)');
ylabel('amplitude (V)');
title('s2 (15.5 periods, 256 samples)');

%% 1.3  Analysis of test signals
[mod, phase, freq] = DFTVisu(s1,fs);

figure()
plot(freq, mod);
grid on;
xlabel('frequence');
ylabel('amplitude');
title('analysis of test signals on DFTVisu');

%% 2.1  DFT interpolation
r=16;
M=N*r;

x1_zp=fftshift(fft(s1,M))/N;
x2_zp=fftshift(fft(s2,M))/N;
freq_zp=(-M/2:M/2-1)*(fs/M);

mod1_zp = abs(x1_zp);
mod2_zp = abs(x2_zp);

figure();
plot(freq_zp, mod1_zp, 'b'); hold on;
[mod1, phase1, freq] = DFTVisu(s1, fs);
stem(freq, mod1, 'r');
grid on; xlim([-30 30]);
xlabel('frequence (Hz)'); ylabel('amplitude');
title('s1 with zero-padding (factor 16)');
legend('zero-padding (4096 pts)', 'original (256 pts)');

%% 3 Time windowing and apodization
n=64;
r=16;
m=n*r;

w_rec=rectwin(n);
w_hann=hann(n);
w_hamm=hamming(n);

W_rec=fftshift(fft(w_rec,m));
W_hann=fftshift(fft(w_hann,m));
W_hamm=fftshift(fft(w_hamm,m));

f=(-m/2:m/2-1)*fs/m;
eps = 0.001;
W_rec_dB=20*log10(abs(W_rec)/sum(w_rec)+eps);
W_hann_dB=20*log10(abs(W_hann)/sum(w_hann)+eps);
W_hamm_dB=20*log10(abs(W_hamm)/sum(w_hamm)+eps);

figure;

subplot(3,1,1);
plot(f, W_rec_dB);
grid on;
xlabel('frequency');
ylabel('magnitude');
title("rectangular window");

subplot(3,1,2);
plot(f, W_hann_dB);
grid on;
xlabel('frequency');
ylabel('magnitude');
title("hann window");

subplot(3,1,3);
plot(f, W_hamm_dB);
grid on;
xlabel('frequency');
ylabel('magnitude');
title("hamming window");


s1_rec=conv

