
clear all
close all ;
clc
%% 4 - Spectral analysis of SigTest

% Load signal
load('SigTest.mat');

x=SigTest(:);
N=length(x);

% Plot signal
figure;
plot(0:N-1,x);
xlim([0 400]);
grid on;
xlabel('Samples');
ylabel('Amplitude');
title('Unknown signal - SigTest');

%% FFT with zero-padding

r=16;
M=N*r;

X=fft(x,M);

% Positive frequencies
X=X(1:M/2+1);

% Normalized frequency (cycles/sample)
freq_norm=(0:M/2)'/M;

% Amplitude normalization
mod=abs(X)/N;
mod(2:end-1)=2*mod(2:end-1);

figure;
plot(freq_norm,mod);
xlim([0 0.3]);
grid on;
xlabel('Normalized frequency (cycles/sample)');
ylabel('Amplitude');
title('DFT of SigTest');

%% Hann window

w=hann(N);
x_hann=x.*w;

X_hann= fft(x_hann,M);
X_hann = X_hann(1:M/2+1);

mod_hann = abs(X_hann)/sum(w);
mod_hann(2:end-1) = 2*mod_hann(2:end-1);

figure;
plot(freq_norm,mod,'b');
hold on;
plot(freq_norm,mod_hann,'r');
grid on;
xlabel('Normalized frequency (cycles/sample)');
ylabel('Amplitude');
title('Spectral analysis - SigTest');

legend('Rectangular','Hann');
xlim([0 0.3]);
